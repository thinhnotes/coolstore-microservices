{
  "App": {
    "Name": "webapigatewayapp"
  },
  "Services": {
    "inventoryapp": "http://localhost:5002",
    "productcatalogapp": "http://localhost:5003",
    "shoppingcartapp": "http://localhost:5004",
    "saleapp": "http://localhost:5005"
  },
  "OtelZipkin": {
    "ServiceName": "webapi-gateway",
    "Endpoint": "http://localhost:9411/api/v2/spans"
  },
  "Logging": {
    "FluentdEnabled": false,
    "EsUrl": "http://localhost:9200",
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "inv": {
        "ClusterId": "inv-svc-cluster",
        "Match": {
          "Path": "/inv/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/inv" }
        ]
      },
      "prod": {
        "ClusterId": "prod-svc-cluster",
        "Match": {
          "Path": "/prod/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/prod" }
        ]
      },
      "cart": {
        "ClusterId": "cart-svc-cluster",
        "Match": {
          "Path": "/cart/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/cart" }
        ]
      },
      "sale": {
        "ClusterId": "sale-svc-cluster",
        "Match": {
          "Path": "/sale/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/sale" }
        ]
      }
    },
    "Clusters": {
      "inv-svc-cluster": {
        "Destinations": {
          "inv/destination1": {
            "Address": "http://inventory-api"
          }
        }
      },
      "prod-svc-cluster": {
        "Destinations": {
          "inv/destination1": {
            "Address": "http://product-api"
          }
        }
      },
      "cart-svc-cluster": {
        "Destinations": {
          "inv/destination1": {
            "Address": "http://shoppingcart-api"
          }
        }
      },
      "sale-svc-cluster": {
        "Destinations": {
          "inv/destination1": {
            "Address": "http://sale-api"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
