{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ingress": {
    "Port": 5000
  },
  "ReverseProxy": {
    "Routes": {
      "inv": {
        "ClusterId": "inv-svc-cluster",
        "Match": {
          "Path": "/inv/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/inv" }
        ]
      },
      "prod": {
        "ClusterId": "prod-svc-cluster",
        "Match": {
          "Path": "/prod/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/prod" }
        ]
      },
      "cart": {
        "ClusterId": "cart-svc-cluster",
        "Match": {
          "Path": "/cart/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/cart" }
        ]
      },
      "sale": {
        "ClusterId": "sale-svc-cluster",
        "Match": {
          "Path": "/sale/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/sale" }
        ]
      }
    },
    "Clusters": {
      "inv-svc-cluster": {
        "Destinations": {
          "inv/destination1": {
            "Address": "http://inventory-api"
          }
        }
      },
      "prod-svc-cluster": {
        "Destinations": {
          "inv/destination1": {
            "Address": "http://product-api"
          }
        }
      },
      "cart-svc-cluster": {
        "Destinations": {
          "inv/destination1": {
            "Address": "http://shoppingcart-api"
          }
        }
      },
      "sale-svc-cluster": {
        "Destinations": {
          "inv/destination1": {
            "Address": "http://sale-api"
          }
        }
      }
    }
  }
}
